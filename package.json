{
  "name": "medstock",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @medstock/shared-types --filter @medstock/database build && pnpm --filter @medstock/api --filter @medstock/web --parallel dev",
    "dev:web": "pnpm --filter @medstock/web dev",
    "dev:api": "pnpm --filter @medstock/api dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @medstock/shared-types --filter @medstock/database build && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @medstock/shared-types build && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @medstock/database generate"
  }
}
