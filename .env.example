# Local defaults match infrastructure/docker/docker-compose.yml.
# Replace every value outside this local Compose setup. Do not commit real secrets.

POSTGRES_USER=medstock
POSTGRES_PASSWORD=medstock
POSTGRES_DB=medstock
# Host port for Postgres. Use another value when 5432 is already taken.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medstock:medstock@localhost:5432/medstock
REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
PORT=3001

# Required together in production. Leave all three empty locally to reject every bearer token.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional. Must equal https://cognito-idp.$COGNITO_REGION.amazonaws.com/$COGNITO_USER_POOL_ID
OIDC_ISSUER=
# Must stay false. It does not sign anyone in, and production refuses to start when it is true.
AUTH_DEV_MODE=false
# Local UI preview for the web app only. Leave false. Set true in apps/web/.env.local
# to render the existing retailer and distributor screens with labeled mock data.
# It does not sign anyone in, does not call the API as an authenticated user, and is
# refused when NODE_ENV=production. Do not use a NEXT_PUBLIC_ name for this flag.
MEDSTOCK_LOCAL_PREVIEW=false
NODE_ENV=development

# Web sign-in. Next.js reads apps/web/.env.local. Copy the names above plus these.
# Production WEB_ORIGIN must be one https origin. Do not use *.
# Hosted UI hostname only, for example medstock.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=
# At least 32 characters. Server only. Generate with: openssl rand -base64 48
# Rotating it signs every browser out. It does not decrypt old cookies.
SESSION_SECRET=
# Optional. Server only. Leave empty for a public Cognito app client that uses PKCE.
COGNITO_CLIENT_SECRET=
